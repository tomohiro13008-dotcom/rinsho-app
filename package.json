{
  "name": "rinsho-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "地域で怖くない臨床力アプリ（教育・訓練用のオフラインPWA）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/gen-sw.mjs",
    "build:public": "PUBLIC_BUILD=1 npm run build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "node scripts/check.mjs",
    "check:strict": "node scripts/check.mjs --strict",
    "test": "vitest run",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  }
}
