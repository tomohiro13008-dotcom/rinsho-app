{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "table.schema.json",
  "title": "Table（表）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "columns",
    "rows"
  ],
  "properties": {
    "caption": {
      "type": "string"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string"
    },
    "stack": {
      "type": "boolean"
    }
  }
}
