{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review.schema.json",
  "title": "Review（レビューの段階）",
  "type": "object",
  "additionalProperties": false,
  "required": ["level"],
  "properties": {
    "level": { "enum": [0, 1, 2, 3] },
    "byRole": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
