{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "topic.schema.json",
  "title": "Topic（参照項目）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "field",
    "title",
    "tags",
    "summary",
    "points",
    "sections",
    "pitfalls",
    "sources",
    "verification",
    "updatedAt",
    "review"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "field": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "points": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "table": {
            "$ref": "table.schema.json"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "sourceIndexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "template": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lines"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "pitfalls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drugs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "source.schema.json"
      }
    },
    "verification": {
      "$ref": "verification.schema.json"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review": {
      "$ref": "review.schema.json"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    }
  }
}
