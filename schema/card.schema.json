{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "card.schema.json",
  "title": "Card（柱A：状態別カード）",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "states", "scenes", "specialties", "summary", "firstActions", "steps", "branches", "callForHelp", "pitfalls", "sources", "updatedAt", "review"],
  "properties": {
    "$comment": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "common": { "type": "boolean" },
    "states": { "type": "array", "items": { "type": "string" } },
    "scenes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "specialties": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
    "firstActions": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "kind"],
        "properties": {
          "text": { "type": "string" },
          "kind": { "enum": ["procedure", "decision", "number", "equipment", "communication"] },
          "requires": { "type": "array", "items": { "type": "string" } },
          "ifMissing": { "type": "string" },
          "keyword": { "type": "string" }
        }
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["if", "then"],
        "properties": { "if": { "type": "string" }, "then": { "type": "string" }, "else": { "type": "string" } }
      }
    },
    "callForHelp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria"],
      "properties": {
        "criteria": { "type": "array", "items": { "type": "string" } },
        "whom": { "type": "string" },
        "script": { "type": "string" }
      }
    },
    "transfer": { "type": "string" },
    "pitfalls": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "$ref": "source.schema.json" } },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "review": { "$ref": "review.schema.json" },
    "drills": { "type": "array", "items": { "type": "string" } },
    "firstCalls": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "看護師の第一声。学習の想起で題名の代わりに出す" }
  }
}
